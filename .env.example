# העתיקי קובץ זה לשם .env והחליפי את הערכים. את .env אסור להעלות ל-GitHub!

# כתובת החיבור למסד הנתונים PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# מפתח סודי לחתימת ה-JWT. חייב להיות ארוך (לפחות 32 תווים) ואקראי.
# ליצירת מפתח: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# תוקף ה-Token (למשל 8h, 1d)
JWT_EXPIRES_IN="8h"

# כתובות ה-React שמותר להן לפנות לשרת, מופרדות בפסיק. לדוגמה:
# http://localhost:5173,https://my-app.vercel.app
# אפשר להשתמש ב-* רק לבדיקות.
CORS_ORIGIN="http://localhost:5173"

# הפורט (בענן מגיע אוטומטית)
PORT=3000

# development / production / test
NODE_ENV="development"

# יצירת מנהל ראשי אוטומטית בעליית השרת (רשות, מומלץ בפריסה):
# אם שני הערכים מוגדרים, השרת יוצר מנהל ראשי עם הפרטים האלה (אם לא קיים).
# הסיסמה חייבת להיות באורך 10 תווים לפחות.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="מנהל ראשי"
